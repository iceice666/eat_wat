# LibreLinkUp「追蹤者」帳號（不是你自己的 FreeStyle Libre 帳號）
# 先在 FreeStyle Libre / LibreLink App 裡邀請這個帳號，並在 LibreLinkUp App 接受邀請。
LLU_EMAIL=
LLU_PASSWORD=

# 選填：有多個分享連線時，指定 patientId（啟動後 log 會列出所有連線）
LLU_PATIENT_ID=
# 選填：直接指定區域（如 eu、us、ap、jp）。留空則由登入回應自動轉址。
LLU_REGION=
# 選填：App 版本 header，API 拒絕舊版本時調高
LLU_VERSION=4.16.0

# 輪詢間隔（分鐘）。graph API 只給最近約 12 小時，伺服器需持續執行才能累積資料。
POLL_INTERVAL_MIN=5

# 伺服器綁定位址。預設只聽本機。
# 設成 0.0.0.0 讓手機在區網連線時，必須同時設定 APP_TOKEN。
HOST=127.0.0.1
PORT=3000
APP_TOKEN=

# 資料目錄（SQLite + 照片）
DATA_DIR=./data

# 設成 1 使用內建假資料（不連 Abbott）
LLU_MOCK=0
